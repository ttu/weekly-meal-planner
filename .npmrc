# Metro (React Native's bundler) cannot follow pnpm's symlinked store: it
# resolves modules by walking real paths, so a symlinked node_modules produces
# "Unable to resolve module" failures that look like missing dependencies.
# A hoisted layout keeps pnpm's fast, deduplicated store while giving Metro the
# flat tree it expects.
node-linker=hoisted

# Expo and React Native ship loose peer ranges; failing installs on them stops
# work without catching real problems.
strict-peer-dependencies=false
