{
  "name": "weekly-meal-planner",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "build": "expo export --platform web",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run lint:boundaries && pnpm run lint:duplication && pnpm run type-check && pnpm run test && pnpm run build",
    "validate:all": "pnpm run validate",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "lint:duplication": "jscpd",
    "prepare": "husky",
    "db:seed": "tsx --env-file=.env scripts/seed-demo.ts",
    "db:reset": "supabase db reset",
    "db:fresh": "pnpm run db:reset && pnpm run catalogue:sync && pnpm run db:seed",
    "db:types": "supabase gen types typescript --local > src/shared/db/database.types.ts",
    "test:e2e": "playwright test",
    "catalogue:sync": "tsx --env-file=.env scripts/catalogue-sync.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.20",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.9",
    "expo-localization": "^57.0.1",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react-native-web-vite": "^10.6.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "jscpd": "^5.2.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.8",
    "storybook": "^10.6.0",
    "supabase": "^2.117.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
